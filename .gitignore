# runtime / agent state
.pi/
.beads/
.bv/
.checkpoints/
.pytest_cache/
__pycache__/
*.py[cod]
*.so
.Python
*.egg-info/
.mypy_cache/
.ruff_cache/

# Cloak / Chromium user-data (never commit cookies/caches).
# Tracked under profiles/: PROFILES.json + docs only.
profiles/**
!profiles/BINDING.md
!profiles/PROFILES.json
!profiles/README.md

# leftover runtime ledgers (if present from older trees)
profiles/IDENTITIES.json
profiles/API_STAGES.json
profiles/.PROFILES.json.lock
profiles/.IDENTITIES.json.lock
profiles/.API_STAGES.json.lock

# daemon sockets, events, provenance, leases, optional viewer-root
state/**

# one-off scratch / capture dumps
page_source.html
paste_and_submit*.js
fill_and_submit.js
*.png
/tmp/

# local secrets
secrets/
findings/
.env
.env.*

# VPN creds (account-scoped, not for git)
vpn/.wireguard.env
state/vpn_runtime.json
profiles/vpn/
state/vpn_browser_logs/
